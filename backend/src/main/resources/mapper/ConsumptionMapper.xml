<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.farm.repository.ConsumptionMapper">

    <resultMap id="BaseResultMap" type="com.farm.entity.Consumption">
        <id column="id" property="id"/>
        <result column="insert_time" property="insertTime"/>
        <result column="amount" property="amount"/>
        <association column="product_id" property="product"
                     javaType="com.farm.entity.Product"
                     select="com.farm.repository.ProductMapper.selectByPrimaryKey"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO consumption (insert_time, amount, product_id)
        VALUES (#{insertTime}, #{amount}, #{product.id})
    </insert>

</mapper>

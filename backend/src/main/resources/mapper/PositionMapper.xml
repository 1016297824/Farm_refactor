<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.farm.repository.PositionMapper">

    <resultMap id="BaseResultMap" type="com.farm.entity.Position">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="location" property="location"/>
        <result column="basic_salary" property="basicSalary"/>
        <result column="authority" property="authority"/>
    </resultMap>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT * FROM position
    </select>

    <select id="selectByPrimaryKey" resultMap="BaseResultMap">
        SELECT * FROM position WHERE id = #{id}
    </select>

    <select id="findManagerAndStaff" resultMap="BaseResultMap">
        SELECT * FROM position WHERE authority &lt;&gt; 'SuperManager'
    </select>

    <select id="findAllFarmStaff" resultMap="BaseResultMap">
        SELECT * FROM position WHERE authority = 'FarmStaff'
    </select>

    <select id="findAllRestaurantStaff" resultMap="BaseResultMap">
        SELECT * FROM position WHERE authority = 'RestaurantStaff'
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO position (name, location, basic_salary, authority)
        VALUES (#{name}, #{location}, #{basicSalary}, #{authority})
    </insert>

    <update id="updateByPrimaryKey">
        UPDATE position SET name = #{name}, location = #{location},
            basic_salary = #{basicSalary}, authority = #{authority}
        WHERE id = #{id}
    </update>

</mapper>

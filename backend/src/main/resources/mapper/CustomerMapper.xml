<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.farm.repository.CustomerMapper">

    <resultMap id="BaseResultMap" type="com.farm.entity.Customer">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="name" property="name"/>
    </resultMap>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT * FROM customer
    </select>

    <select id="findByUsername" resultMap="BaseResultMap">
        SELECT * FROM customer WHERE username = #{username}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO customer (username, password, name)
        VALUES (#{username}, #{password}, #{name})
    </insert>

    <update id="updateByPrimaryKey">
        UPDATE customer SET username = #{username}, password = #{password}, name = #{name}
        WHERE id = #{id}
    </update>

    <select id="selectByPrimaryKey" resultMap="BaseResultMap">
        SELECT * FROM customer WHERE id = #{id}
    </select>

</mapper>

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.farm.repository.MenuMapper">

    <resultMap id="BaseResultMap" type="com.farm.entity.Menu">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="price" property="price"/>
        <result column="unite" property="unite"/>
        <result column="type" property="type"/>
    </resultMap>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT * FROM menu
    </select>

    <select id="selectByPrimaryKey" resultMap="BaseResultMap">
        SELECT * FROM menu WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO menu (name, price, unite, type)
        VALUES (#{name}, #{price}, #{unite}, #{type})
    </insert>

    <update id="updateByPrimaryKey">
        UPDATE menu SET name = #{name}, price = #{price}, unite = #{unite}, type = #{type}
        WHERE id = #{id}
    </update>

    <delete id="deleteByPrimaryKey">
        DELETE FROM menu WHERE id = #{id}
    </delete>

</mapper>

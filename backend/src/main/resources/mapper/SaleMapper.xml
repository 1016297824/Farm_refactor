<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.farm.repository.SaleMapper">

    <resultMap id="BaseResultMap" type="com.farm.entity.Sale">
        <id column="id" property="id"/>
        <result column="amount" property="amount"/>
        <result column="price" property="price"/>
        <association column="sale_no_id" property="saleNo"
                     javaType="com.farm.entity.SaleNo"
                     select="com.farm.repository.SaleNoMapper.selectByPrimaryKey"/>
        <association column="product_id" property="product"
                     javaType="com.farm.entity.Product"
                     select="com.farm.repository.ProductMapper.selectByPrimaryKey"/>
    </resultMap>

    <select id="findByTime" resultMap="BaseResultMap">
        SELECT s.* FROM sale s
        JOIN sale_no sn ON s.sale_no_id = sn.id
        WHERE sn.insert_time &gt;= #{startTime} AND sn.insert_time &lt;= #{endTime}
    </select>

    <select id="findByNo" resultMap="BaseResultMap">
        SELECT s.* FROM sale s
        JOIN sale_no sn ON s.sale_no_id = sn.id
        WHERE sn.no = #{no}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sale (amount, price, sale_no_id, product_id)
        VALUES (#{amount}, #{price}, #{saleNo.id}, #{product.id})
    </insert>

</mapper>

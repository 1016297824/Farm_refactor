<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.farm.repository.RepairMapper">

    <resultMap id="BaseResultMap" type="com.farm.entity.Repair">
        <id column="id" property="id"/>
        <result column="insert_time" property="insertTime"/>
        <result column="repair_type" property="repairType"/>
        <result column="content" property="content"/>
        <result column="cause" property="cause"/>
        <result column="state" property="state"/>
        <result column="price" property="price"/>
    </resultMap>

    <select id="findByState" resultMap="BaseResultMap">
        SELECT * FROM repair WHERE state = #{repairState}
    </select>

    <select id="findByTime" resultMap="BaseResultMap">
        SELECT * FROM repair
        WHERE insert_time &gt;= #{startTime} AND insert_time &lt; #{endTime}
    </select>

    <select id="selectByPrimaryKey" resultMap="BaseResultMap">
        SELECT * FROM repair WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO repair (insert_time, repair_type, content, cause, state, price)
        VALUES (#{insertTime}, #{repairType}, #{content}, #{cause}, #{state}, #{price})
    </insert>

    <update id="updateByPrimaryKey">
        UPDATE repair SET insert_time = #{insertTime}, repair_type = #{repairType},
               content = #{content}, cause = #{cause}, state = #{state}, price = #{price}
        WHERE id = #{id}
    </update>

    <delete id="deleteByPrimaryKey">
        DELETE FROM repair WHERE id = #{id}
    </delete>

</mapper>
